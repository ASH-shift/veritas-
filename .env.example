# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://veritas:veritas@localhost:5432/veritas

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Observability (optional — app runs fine without these) ────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Ingestion ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=450
CHUNK_OVERLAP=60

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# ── Cache ─────────────────────────────────────────────────────────────────────
EXACT_CACHE_TTL=86400
SEMANTIC_CACHE_THRESHOLD=0.95

# ── MCP Server ────────────────────────────────────────────────────────────────
# Set in your Claude Desktop / Cursor config to authenticate the MCP server.
# MCP_API_KEY is validated on every tool call; MCP_WORKSPACE_ID selects the workspace.
MCP_API_KEY=change-me-to-a-secret-key
MCP_WORKSPACE_ID=1

# Public demo (/demo page, no login) reads this workspace — the one sample_docs are ingested into.
DEMO_WORKSPACE_ID=1

# Host port for the Postgres container (change if a local Postgres already uses 5432;
# then update DATABASE_URL to match).
DB_PORT=5432

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
